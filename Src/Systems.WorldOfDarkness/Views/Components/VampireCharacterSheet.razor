<h1>Character Sheet</h1>

<div id="character-info">
    <table>
        <tr>
            <th class="label">Name:</th>
            <td><input type="text" id="name" value="" placeholder="Character name"></td>
        </tr>
        <tr>
            <th class="label">Concept:</th>
            <td><input type="text" id="concept" value=""></td>
        </tr>
        <tr>
            <th class="label">Chronicle:</th>
            <td><input type="text" id="chronicle" value=""></td>
        </tr>
        <tr>
            <th class="label">Ambition:</th>
            <td><input type="text" id="ambition" value=""></td>
        </tr>
        <tr>
            <th class="label">Clan:</th>
            <td><input type="text" id="clan" value="" placeholder="Clan name"></td>
        </tr>
    </table>
</div>

